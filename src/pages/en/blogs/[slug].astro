---
// English half of the post route. See the note in ../../blogs/[slug].astro:
// zh and en must be two files, not one route returning two languages, or both
// languages compete for the same URL and one of them never renders.
import Post from '../../../layouts/Post.astro';
import { posts } from '../../../content/posts.js';

export function getStaticPaths() {
  return posts.map((p) => ({ params: { slug: p.slug }, props: { slug: p.slug } }));
}

const bodies = import.meta.glob('../../../content/posts/*.en.md', { eager: true });

const { slug } = Astro.props;
const key = '../../../content/posts/' + slug + '.en.md';
const body = bodies[key];
if (!body) throw new Error('missing en body for post "' + slug + '" (expected ' + key + ')');
const Content = body.default;
---

<Post slug={slug} lang="en">
  <Content />
</Post>
