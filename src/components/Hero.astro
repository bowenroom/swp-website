---
// The homepage scroll-film. It hands the vendored scroll-world engine a plain
// config object and stays out of the way: the engine builds its own stage,
// streams each clip into a <video> and scrubs currentTime against scroll
// position. Nothing here needs to know how that works.
//
// Still-first is deliberate. The scene posters are real <img> elements, so the
// first paint never waits on a video, and on a phone -- where stillOnlyMobile
// is on -- no clip is ever requested at all.
import { HERO } from '../content/hero.js';

const { lang = 'zh' } = Astro.props;
const copy = HERO[lang];

// A null id must stay null: the engine treats any non-empty string as a real
// clip to fetch, so 'null.mp4' would turn a still scene into a broken one.
const clipFor = (id) => (id ? `/hero/vid/${id}.mp4` : null);
const stillFor = (id) => `/hero/${id}.jpg`;
const stillMobileFor = (id) => `/hero/${id}-mobile.jpg`;

// Five stills were generated (one per scene) but only four clips exist: the
// closing decision scene is carried by its still and the copy, which is the
// right place for the two CTAs to land. Each scene therefore names its own
// still and its own clip, and the decision scene simply has no clip.
const SCENE_ASSETS = {
  establish: { still: 'k0-establish', clip: 's1-approach' },
  road: { still: 'k1-road', clip: 's2-sensing' },
  sensing: { still: 'k2-sensing', clip: 's3-fusion' },
  fusion: { still: 'k3-fusion', clip: 's4-decision' },
  decision: { still: 'k4-decision', clip: null },
};

const sections = copy.sections.map((s) => {
  const asset = SCENE_ASSETS[s.id];
  return {
    ...s,
    still: stillFor(asset.still),
    stillMobile: stillMobileFor(asset.still),
    clip: asset.clip ? clipFor(asset.clip) : null,
  };
});

// One connector per gap, and every one of them is null.
//
// A connector is meant to be its OWN short clip: scroll-world builds a fly-over
// whose endpoints are the neighbouring dives' real first/last frames, so the
// seam reads as continuous camera motion. No such transitional clips exist for
// this film, and pointing a connector at the outgoing dive's clip made every
// scene play TWICE -- the dive ran the file to its last frame, then the very
// same file ran again from its first frame over the next stretch of scroll.
// That is the 'the last scene keeps repeating' artefact, and no amount of
// engine tuning hides it, because the duplication is in the data, not the code.
//
// A null connector is a first-class case (scrub-engine.js: a falsy entry skips
// the segment entirely), so the chain collapses to five dives that cross-dissolve
// straight into each other. Same number of scenes, same copy timing, no replay.
const connectors = sections.slice(0, -1).map(() => null);
---

<div class="hero-film" id="world" data-lang={lang}></div>

<script is:inline define:vars={{ sections, connectors, copy, stillOnlyMobile: true, lang }}>
  // The engine ships as a plain script under /hero/, so it is loaded on demand
  // rather than bundled: nothing above the fold needs it, and it is ~15 KB.
  const boot = async () => {
    if (!window.mountScrollWorld) {
      await new Promise((resolve, reject) => {
        const s = document.createElement('script');
        s.src = '/hero/scrub-engine.js';
        s.onload = resolve;
        s.onerror = reject;
        document.head.appendChild(s);
      });
    }
    const world = document.getElementById('world');
    if (!world || !window.mountScrollWorld) return;
    window.mountScrollWorld(world, {
      brand: copy.brand,
      hint: copy.hint,
      nav: false,
      atmosphere: true,
      // Phones get the stills only: no clip is fetched, so the homepage opens
      // fast on a mobile connection and the scroll story still reads. Note this
      // keys off viewport width (max-width: 860px) as well as pointer type, so a
      // narrow desktop window also gets stills.
      stillOnlyMobile: true,
      // The homepage news dock floats over the top of the film rather than
      // sitting before it, so the first clip plays a 0.85vh strip behind that
      // layer before the first dive's own scroll range begins. Without it the
      // film's runway would start a full screen down the document and the video
      // would only begin after the dock had scrolled away. See PRE_ROLL in
      // scrub-engine.js -- 0 disables it, and any other page is untouched.
      preRoll: 0.85,
      sections,
      connectors,
      diveScroll: 1.25,
      connScroll: 0.85,
      crossfade: 0.14,
    });
    world.dataset.heroReady = '1';
  };
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot, { once: true });
  } else {
    boot();
  }
</script>

<style>
  /* The engine injects its own namespaced CSS; this only reserves the scroll
     runway it drives, so the page reserves height before the script lands and
     the page does not jump when it does. */
  .hero-film {
    position: relative;
    width: 100%;
    min-height: 100svh;
    background: var(--surface, #f7f6f3);
  }
</style>
