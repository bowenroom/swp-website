---
// 近期动态 / Recent updates — the card that floats over the homepage film.
//
// WHAT CHANGED AND WHY (this file was rebuilt twice in one sitting, so the
// reasoning is worth keeping):
//
// The first version was a full-screen three-column drawing copied from the
// reference recording — news rail on the left, a ripple node in the middle, a
// research tree on the right, all on an opaque parchment ground. It read well
// as its own page and completely hid the scroll-film, which is the entire point
// of the homepage. The second version made the ground translucent, which fixed
// the hiding and immediately created the opposite problem: a 100svh blurred
// wash across the whole viewport with three large columns floating on it, so
// the video was only ever visible through a dirty pane.
//
// This version is the arrangement the user actually asked for, and it is a
// different SHAPE rather than a third set of numbers: the film keeps the whole
// viewport, and the news becomes one compact card pinned to the RIGHT edge.
// The research tree moves INSIDE that card, under the news, because the copy
// column is what owns the left half of the screen — every section's kicker,
// title, body and CTAs are left-aligned with a wash behind them, so a card on
// the left sat on top of them as the reader scrolled out of the first screen
// (先看清楚, 再谈判断 in particular). Nothing here spans more than ~400px, so at
// no point does the content compete with the film for attention.
//
// COLOURS ARE read off the recording (1280x868) rather than chosen:
//   card fill #fbf5eb · border #d3cfc4 · panel fill #fff9ef · border #cfcbc1
//   teal #39715f · guide #dbd5cb · ochre #b5713a · sage #4a7a63
//
// What is NOT copied: the recording is of another company's product. The panel
// spells 师威鹏's own two domains and one shared method. Layout is replicated;
// identity is not.
import { newsFor } from '../content/news.js';
import { researchFor } from '../content/research.js';

const { lang } = Astro.props;
const items = newsFor(lang);
const research = researchFor(lang);
const isZh = lang === 'zh';

// Dates are stored at the precision the source evidence supports (see news.js)
// and formatted here, never padded. '2022' and '2022-11' are real dates here,
// and inventing a day for them would be a fabricated date in a precise costume.
const formatDate = (raw) => {
  const [y, m] = raw.split('-');
  if (!m) return y;
  return isZh ? `${y}.${m}` : `${y} · ${m}`;
};

// Four kinds, four marks. Each is drawn on the same 26.4 grid at the same 1.6
// stroke so the icons stay a family: same weight, same corner treatment, same
// optical size. They are stroked rather than filled, because a filled mark at
// 22px collapses into a blob and the four stop being distinguishable.
const KIND_ACCENT = {
  paper: 'var(--dock-teal)',
  milestone: 'var(--dock-violet)',
  thanks: 'var(--dock-ochre)',
  family: 'var(--dock-sage)',
};

const KIND_MARK = {
  // a journal page with a rule down the spine
  paper: 'M9 2.2h8.4v13.6H9z M9 6.2h8.4 M12.4 2.2v13.6',
  // a seal
  milestone: 'M13.2 3.2 23 9l-9.8 5.8L3.4 9z M6.6 12.4v3.6h13v-3.6',
  // an open hand, offered
  thanks: 'M13.2 4.6c-2.6-1.4-5.6-1.2-7.8.8-2.2 2-2.6 5.4-1 7.8 1.6 2.4 4.6 3.4 7.4 2.6 1.2-.3 2.3-.9 3.1-1.8 M13.2 4.6c.5 3 .2 6-1 8.8',
  // a shelter with a lit door
  family: 'M6.4 11.4 13.2 5l6.8 6.4 M8.2 10.6v9.2h10v-9.2 M11.4 19.8v-4.6h3.6v4.6',
};

// The hover preview needs three strings per entry that the LIST itself does not
// render: the full sentence, the kind label, and the art path. They are handed
// to the client as JSON on the section rather than duplicated into the markup
// of ten rows, so there is exactly one source for each string and the list and
// the preview can never disagree about what an entry says.
const artMap = Object.fromEntries(items.map((i) => [i.id, i.art]));
const kindMap = Object.fromEntries(items.map((i) => [i.id, i.kindLabel]));
const textMap = Object.fromEntries(items.map((i) => [i.id, i.text]));
// The preview reuses `short` as its title and `text` as its body rather than
// inventing a third string: the headline the rail shows and the sentence the
// rail had to cut are the same two halves of one entry, and the preview simply
// shows both at once. It is also why `text` can be dropped when it is only ever
// the long form of `short` -- it never is, because the rail truncates.
const shortMap = Object.fromEntries(items.map((i) => [i.id, i.short[lang]]));
const dateMap = Object.fromEntries(items.map((i) => [i.id, formatDate(i.date)]));
const linkMap = Object.fromEntries(items.map((i) => [i.id, i.href || '']));
---

<section
  class="dock"
  data-dock
  aria-labelledby="dock-title"
  data-dock-art={JSON.stringify(artMap)}
  data-dock-kinds={JSON.stringify(kindMap)}
  data-dock-text={JSON.stringify(textMap)}
  data-dock-short={JSON.stringify(shortMap)}
  data-dock-dates={JSON.stringify(dateMap)}
  data-dock-links={JSON.stringify(linkMap)}
>
  <h2 id="dock-title" class="dock-sr">{isZh ? '近期动态与研究方向' : 'Recent updates and research'}</h2>

  <div class="dock-card">
    <!-- ── news rail ───────────────────────────────────────────────
         Two identical lists in one track, and the TRACK travels. Animating
         the lists separately is what produced the seam the reference does not
         have: two half-length animations meet at slightly different offsets and
         the same card shows twice at the wrap. One track, one clock, one seam. -->
    <div class="dock-news" data-dock-news>
      <p class="dock-kicker">{isZh ? '近期动态' : 'Recent'}</p>
      <div class="dock-viewport" data-dock-viewport>
        <div class="dock-track" data-dock-track>
          <ul class="dock-list">
            {items.map((item) => (
              <li class="dock-row" data-kind={item.kind} data-id={item.id} style={`--accent:${KIND_ACCENT[item.kind]}`}>
                <button class="dock-item" type="button" data-dock-item data-id={item.id}>
                  <span class="dock-item__icon">
                    <svg viewBox="0 0 26.4 26.4" aria-hidden="true">
                      <path d={KIND_MARK[item.kind]} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" />
                    </svg>
                  </span>
                  <span class="dock-item__text">
                    <span class="dock-item__date">{formatDate(item.date)}</span>
                    <span class="dock-item__label">{item.short[lang]}</span>
                  </span>
                  <span class="dock-item__go" aria-hidden="true">
                    <svg viewBox="0 0 16 16">
                      <path d="M3.4 8h9.2 M9 4.6 12.4 8 9 11.4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                </button>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <!-- ── research, now under the news inside the same card ────────
         The tree notation is deliberate rather than decorative: the work really
         is two application domains standing on one shared method, and an
         indented tree states that in a way a flat list of tags cannot. -->
    <div class="dock-tree">
      <p class="dock-tree__root"><span class="dock-tree__accent">{research.root}</span><span class="dock-tree__slash">://</span></p>
      <ul class="dock-tree__list">
        {research.groups.map((g) => (
          <li class="dock-tree__group">
            <span class="dock-tree__group-label">{g.label}<span class="dock-tree__slash">/</span></span>
            <ul class="dock-tree__children">
              {g.children.map((c) => (
                <li class="dock-tree__row">{c.label}</li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </div>

    <!-- ── hover preview ─────────────────────────────────────────────
         ONE card, filled on hover. A card per row would mean ten cards in the
         DOM and ten images fetched on first paint; this fetches nothing until
         a row is hovered, and the src is only reassigned when the id actually
         changes, so re-hovering the same row costs nothing. -->
    <aside class="dock-preview" data-dock-preview aria-live="polite" hidden>
      <!-- A 1x1 transparent GIF, not a missing src. The real `src` is assigned
           * on hover (see the script), because the preview must not cost ten
           * image requests on first paint -- but an <img> with no `src` at all
           * renders as a broken-image box in several browsers before the script
           * ever runs, and that box is the first thing the reader sees if they
           * reach the card with a keyboard before hovering anything. The 1x1 is
           * the cheapest thing that satisfies the image box, and it costs no
           * network request; the dimensions below are the real ones, so the
           * layout does not shift when the photograph arrives. -->
      <img
        class="dock-preview__img"
        data-dock-preview-img
        alt=""
        width="276"
        height="184"
        decoding="async"
        src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
      />
      <div class="dock-preview__body">
        <p class="dock-preview__meta">
          <span data-dock-preview-kind></span>
          <span class="dock-preview__dot">·</span>
          <span data-dock-preview-date></span>
        </p>
        <p class="dock-preview__title" data-dock-preview-title></p>
        <p class="dock-preview__text" data-dock-preview-text></p>
        <a class="dock-preview__cta" data-dock-preview-cta href="#" target="_blank" rel="noopener noreferrer" hidden>
          <span>{isZh ? '查看论文' : 'Read the paper'}</span>
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path d="M3.4 8h9.2 M9 4.6 12.4 8 9 11.4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </aside>
  </div>
</section>

<style>
  .dock {
    --dock-card: #fbf5eb;
    --dock-panel: #fff9ef;
    --dock-hair: #d3cfc4;
    --dock-panel-hair: #cfcbc1;
    --dock-teal: #39715f;
    --dock-teal-ink: #2f6665;
    --dock-violet: #7741fb;
    --dock-guide: #dbd5cb;
    --dock-ochre: #b5713a;
    --dock-sage: #4a7a63;
    --dock-ink: #1d1a15;
    --dock-ink-soft: #2e281e;
    /* The masthead's height. A first guess, not a constant: the script
     * re-measures it on load and on resize, because the masthead wraps from one
     * row to two as the window narrows and a fixed value would leave the card
     * under it at one width and floating short at another. */
    --dock-mast: 141px;
    --dock-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
      'Hiragino Sans GB', 'Microsoft YaHei', system-ui, sans-serif;
    --dock-mono: ui-monospace, 'SF Mono', SFMono-Regular, 'JetBrains Mono',
      'Roboto Mono', Menlo, Consolas, 'Liberation Mono', monospace;

    /* The film is a fixed layer that owns the whole viewport from the first
     * pixel, so this card is the one thing in the document that has to float
     * ABOVE it. 130 clears every film layer (topbar 50, scenes 100-120) and
     * stays below the masthead (200, see over-film.css). */
    position: relative;
    z-index: 130;

    /* A one-screen stage, but the CARD is what is placed — not a drawing
     * centred inside it. Centring the card rather than a 650px rail is what
     * lets the same markup work on a 720px-tall laptop and a 1080px monitor
     * without the news running off the bottom.
     *
     * The stage is one screen MINUS the masthead rather than one screen, and it
     * begins directly under the masthead. A full-screen min-height measured
     * from the document's top made the stage one screen tall starting 189px
     * down, so a card centred inside it was pushed below the fold at every
     * window height -- the research tree was never visible without scrolling,
     * on any screen. Subtracting the masthead measures only the band of screen
     * the film actually leaves free, so the card is centred in that band and
     * still clears the masthead above it. The masthead's own height is a
     * measured value (see the script), because it wraps to two rows on a narrow
     * window and no single hard-coded number is right at every width. */
    align-content: center;
    display: grid;
    /* The card sits on the RIGHT. The film's copy is left-aligned — every
     * section's kicker/title/body/CTA stack against the left gutter with a
     * wash behind them — so a card on the left landed on top of it: "先看清楚,
     * 再谈判断" and the dock's news rows were fighting for the same column as
     * the reader scrolled out of the first screen. The right side of the film
     * is empty by construction (the route rail is the only thing over there),
     * which is where this belongs. */
    justify-items: end;
    min-height: calc(100svh - var(--dock-mast, 141px));
    padding: 20px 0 24px;
  }

  .dock-sr {
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    height: 1px;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }

  /* The card. Translucent paper over moving video, so the reader still feels
   * the film behind it while every glyph keeps its contrast. The blur is what
   * stops the video's high-frequency detail from fighting 13px type; without it
   * the labels sit on moving water and become unreadable in the dark frames. */
  .dock-card {
    backdrop-filter: blur(12px) saturate(118%);
    -webkit-backdrop-filter: blur(12px) saturate(118%);
    background: color-mix(in srgb, var(--dock-card) 90%, transparent);
    border: 1px solid var(--dock-hair);
    /* Pinned to the RIGHT edge with a viewport-relative gutter, never centred:
     * the copy column belongs to the left of the screen. The gutter is sized
     * against the film's route furniture rather than picked by eye. That rail
     * is 34px wide and sits `clamp(14px, 2.4vw, 30px)` off the right edge, and
     * EVERY dot hangs a label pill off its own left side — the pills are
     * absolutely positioned, so they reach ~49px (建立) to ~102px (Coordination)
     * further left than the rail's box, into exactly the band a right-pinned
     * card would occupy.
     *
     * It is a CONSTANT, not a clamp, because the thing it clears is constant:
     * the rail's own offsets are px-clamped, so measuring the widest pill's
     * left edge at 1920/1440/1180/980/921/900/861 gives 176/176/174/169/168/
     * 167/166px of required inset — flat to within 10px while 13vw would have
     * swung from 112 to 250 across the same range. 180 clears the worst case
     * with the scrollbar either present or overlaid, in both languages. */
    margin-right: 180px;
    max-width: calc(100vw - 40px);
    padding: 20px 0;
    position: relative;
    width: clamp(296px, 25vw, 372px);
  }

  /* A hairline inset 5px from the border, in the guide colour. The recording
   * reads as a paper edge rather than a UI border, and it stops the card from
   * looking like a piece of frosted glass when the video behind it goes dark. */
  .dock-card::after {
    border: 1px solid color-mix(in srgb, var(--dock-guide) 55%, transparent);
    content: '';
    inset: 5px;
    pointer-events: none;
    position: absolute;
  }

  .dock-kicker {
    color: var(--dock-teal-ink);
    font-family: var(--dock-sans);
    font-size: 12px;
    font-weight: 600;
    /* Wide tracking is correct HERE and nowhere else in this file: this is a
     * short uppercase micro-label, which is the one case the style guide
     * sanctions. No body text in this component sets letter-spacing above 0. */
    letter-spacing: 0.16em;
    line-height: 1.5;
    margin: 0 20px 8px;
    text-transform: uppercase;
  }

  /* ── news rail ─────────────────────────────────────────────────── */
  .dock-news { min-width: 0; }

  /* How much of the card the news rail is allowed to take.
   *
   * The rail is the only part of the card with a flexible height; everything
   * below it is fixed. Measured, the card is (this value + 258) tall and the
   * stage around it adds 44px of padding, so the pair has to fit inside the
   * band the masthead leaves free -- the viewport minus the measured masthead.
   * The 497 subtracted here is that 258, plus the 44 of stage padding, plus 16
   * of air so the card is not sitting flush against the fold, which is what
   * made a 720px-tall window clip the research tree by a hair. The 16 is split
   * by the stage's own even padding, so 8px ends up above the card and 8 below.
   *
   * dvh rather than svh, deliberately: svh is the viewport height with the
   * browser's chrome subtracted, so on a desktop it is a constant that does not
   * move when the window is resized. The band this has to fit IS the window, so
   * the unit has to follow the window or the rail would stop adapting exactly
   * when it is needed.
   *
   * The two bounds matter in opposite directions. The min() keeps the rail at
   * its designed height on a tall window instead of stretching it to fill. The
   * max() is a floor: the rail is a scrolling window onto the news, so as long
   * as it shows a couple of rows and dissolves at both ends it still reads as a
   * window; below it, on a window too short to give the rail its design
   * height, the card would otherwise push the research tree off the fold. */
  .dock {
    --dock-news-h: max(120px, min(262px, calc(100dvh - var(--dock-mast, 141px) - 497px)));
  }

  /* Roughly four rows crisp at the designed height, dissolving at both ends.
   * The mask is what makes the column read as a window onto a moving list
   * rather than a list someone forgot to finish — the recording fades a card
   * out at the top and another in at the bottom instead of hard-clipping them.
   *
   * The bands are a fixed 12px, not a percentage. Measured on the real card:
   * the rail is 261px tall and a row is 59px, so the old 11%/89% (29px, almost
   * half a row) sat ON TOP OF the row's text — the date line box starts 11px
   * into the row, so from 11px to 29px the type you were reading was being
   * faded, and the entry under the cursor looked greyed out and cut off. At
   * 12px the band covers the row's hairline and its top padding and stops
   * exactly where the text begins, so a row's ink is legible from the moment
   * it clears the rail's edge while the edge still dissolves. */
  .dock-viewport {
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 12px, #000 calc(100% - 12px), transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0, #000 12px, #000 calc(100% - 12px), transparent 100%);
    height: var(--dock-news-h);
    overflow: hidden;
  }

  .dock-track { will-change: transform; }

  .dock-list {
    display: flex;
    flex-direction: column;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .dock-row {
    border-top: 1px solid color-mix(in srgb, var(--dock-hair) 75%, transparent);
    position: relative;
  }

  /* The kind's own colour, as a 2px bar that grows from the top edge on hover.
   * A wash behind the text would fight the translucency; a bar reads as an
   * index mark and keeps the four kinds distinguishable at a glance. */
  .dock-row::before {
    background: var(--accent, transparent);
    content: '';
    /* Full-height bar, scaled down to nothing rather than animated from
     * `height: 0`. Animating height re-runs layout on every frame of the 0.2s
     * transition, and this bar sits on a row inside a list that is already
     * being transformed every frame by the news loop -- so the hover was
     * asking layout to recalculate during an animation. `scaleY` is composed
     * on the GPU instead and never touches layout, and because the element is
     * already full height the visual result is identical. */
    height: 100%;
    left: 0;
    position: absolute;
    top: 0;
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.2s ease;
    width: 2px;
  }

  .dock-row.is-hot::before { transform: scaleY(1); }

  .dock-item {
    align-items: center;
    background: none;
    border: 0;
    color: inherit;
    cursor: pointer;
    display: flex;
    font: inherit;
    gap: 12px;
    padding: 10px 20px;
    text-align: left;
    width: 100%;
  }

  .dock-item:hover,
  .dock-item:focus-visible {
    background: color-mix(in srgb, var(--dock-panel) 72%, transparent);
  }

  .dock-item:focus-visible {
    outline: 2px solid var(--dock-teal);
    outline-offset: -3px;
  }

  .dock-item__icon {
    color: var(--accent, var(--dock-teal));
    flex: none;
    height: 22px;
    width: 22px;
  }

  .dock-item__icon svg { display: block; height: 100%; width: 100%; }

  .dock-item__text {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .dock-item__date {
    color: var(--dock-teal-ink);
    font-family: var(--dock-mono);
    font-size: 11px;
    letter-spacing: 0.03em;
    line-height: 1.4;
  }

  .dock-item__label {
    color: var(--dock-ink);
    font-family: var(--dock-sans);
    font-size: 15px;
    font-weight: 600;
    /* 1.45 rather than the 1.35 the recording was measured at: the measured
     * value was for a single short line, and this label wraps to two on a
     * narrow window, where 1.35 sets the second line into the first. */
    line-height: 1.45;
    min-width: 0;
  }

  /* The affordance arrow. Hidden until hover so the resting rail is quiet, and
   * hidden from AT as well, since the button's own label already says what it
   * opens. */
  .dock-item__go {
    color: var(--dock-teal-ink);
    flex: none;
    height: 16px;
    margin-left: auto;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    width: 16px;
  }

  .dock-item__go svg { display: block; height: 100%; width: 100%; }

  .dock-item:hover .dock-item__go,
  .dock-item:focus-visible .dock-item__go {
    opacity: 0.85;
    transform: translateX(0);
  }

  /* ── research tree ──────────────────────────────────────────────── */
  .dock-tree {
    border-top: 1px solid var(--dock-panel-hair);
    margin: 16px 20px 0;
    padding-top: 14px;
  }

  .dock-tree p,
  .dock-tree ul { margin: 0; }

  .dock-tree__root {
    font-family: var(--dock-mono);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.4;
    margin-bottom: 6px;
  }

  .dock-tree__accent,
  .dock-tree__slash { color: var(--dock-teal-ink); }

  .dock-tree__list {
    border-left: 1px solid var(--dock-guide);
    list-style: none;
    padding-left: 16px;
  }

  .dock-tree__group-label,
  .dock-tree__row {
    font-family: var(--dock-mono);
    font-size: 13px;
    letter-spacing: 0;
    line-height: 1.9;
  }

  .dock-tree__group-label {
    color: var(--dock-ink-soft);
    font-weight: 600;
  }

  .dock-tree__group-label .dock-tree__slash { color: var(--dock-teal-ink); }

  .dock-tree__children {
    border-left: 1px solid var(--dock-guide);
    list-style: none;
    margin: 0 0 0 2px;
    padding: 0 0 0 14px;
  }

  .dock-tree__row { color: var(--dock-ink-soft); }

  /* ── hover preview ──────────────────────────────────────────────── */
  /* Positioned against .dock-card, so `right: 100%` is the card's LEFT edge and
   * the preview opens INWARD, over the film: never over the news it is
   * describing. The card is pinned to the RIGHT edge of the screen, so opening
   * outward would push 276px of panel straight off the viewport. The 14px gap
   * is now to the left of the card, and it is the same gap the leave handler
   * below has to survive.
   *
   * `pointer-events` is off while closed and back on once open, so the card can
   * never intercept a click meant for the film, but the reader CAN move the
   * pointer onto an open preview — which is what makes the "read the paper"
   * link reachable, and what makes crossing the gap survivable. */
  .dock-preview {
    background: var(--dock-panel);
    border: 1px solid var(--dock-panel-hair);
    margin-right: 14px;
    opacity: 0;
    padding: 10px;
    pointer-events: none;
    position: absolute;
    right: 100%;
    top: 0;
    transform: translateY(6px);
    transition: opacity 0.18s ease, transform 0.18s ease;
    visibility: hidden;
    width: 276px;
    z-index: 3;
  }

  .dock-preview[hidden] { display: none; }

  .dock-preview.is-open {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
    visibility: visible;
  }

  .dock-preview__img {
    aspect-ratio: 3 / 2;
    background: var(--inline-bg, #f0eee6);
    display: block;
    height: auto;
    object-fit: cover;
    width: 100%;
  }

  .dock-preview__body { padding: 9px 4px 3px; }

  .dock-preview__meta {
    color: var(--dock-teal-ink);
    font-family: var(--dock-mono);
    font-size: 11px;
    letter-spacing: 0.03em;
    line-height: 1.5;
    margin: 0 0 3px;
  }

  .dock-preview__dot { margin: 0 5px; opacity: 0.55; }

  .dock-preview__title {
    color: var(--dock-ink);
    font-family: var(--dock-sans);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.5;
    margin: 0 0 5px;
  }

  .dock-preview__text {
    color: var(--dock-ink-soft);
    font-family: var(--dock-sans);
    font-size: 13px;
    line-height: 1.65;
    margin: 0;
  }

  /* The DOI link only exists for paper entries, so it is hidden rather than
   * absent for the other three kinds: a permanently blank row would read as a
   * broken layout, and a permanently present one would be a dead link. */
  .dock-preview__cta {
    align-items: center;
    color: var(--dock-teal-ink);
    display: inline-flex;
    font-family: var(--dock-sans);
    font-size: 12px;
    font-weight: 600;
    gap: 5px;
    margin-top: 8px;
    text-decoration: none;
  }

  .dock-preview__cta[hidden] { display: none; }

  .dock-preview__cta:hover { text-decoration: underline; }

  .dock-preview__cta svg { height: 13px; width: 13px; }

  /* ── motion ─────────────────────────────────────────────────────── */
  /* One clock for the whole rail. The duration is derived from the MEASURED
   * list height, so a change of row pitch or entry count cannot leave the loop
   * out of phase with its own geometry — which is what produced the visible
   * duplicate at the wrap in an earlier build. */
  @media (prefers-reduced-motion: no-preference) {
    .dock-track--loop { animation: dock-travel var(--dock-loop, 40s) linear infinite; }
  }

  @keyframes dock-travel {
    from { transform: translateY(0); }
    to   { transform: translateY(calc(0px - var(--dock-loop-px, 100px))); }
  }

  /* Parking the rail on hover/focus: an endlessly moving list is a reading
   * hazard, and a target that keeps moving is unusable from a keyboard. The
   * script also sets this class, so a programmatically opened preview pauses
   * the rail even when the pointer is not over the viewport. */
  @media (prefers-reduced-motion: no-preference) {
    .dock-viewport:hover .dock-track--loop,
    .dock-viewport:focus-within .dock-track--loop,
    .dock-news.is-paused .dock-track--loop {
      animation-play-state: paused;
    }
  }

  /* ── responsive ─────────────────────────────────────────────────── */
  /* Desktop first, because the arrangement IS a desktop drawing. The rules
   * below only rescue narrow windows; they never restack news above research,
   * because a stack would push the research under the fold and hand the whole
   * first screen to the film alone. */
  @media (max-width: 1180px) {
    .dock { --dock-news-h: max(116px, min(236px, calc(100dvh - var(--dock-mast, 141px) - 497px))); }
    .dock-card { width: clamp(280px, 28vw, 330px); }
    .dock-item__label { font-size: 14px; }
  }

  @media (max-width: 980px) {
    .dock {
      --dock-news-h: max(104px, min(210px, calc(100dvh - var(--dock-mast, 141px) - 497px)));
      padding: 18px 0 22px;
    }
    /* 240px, not the 288px this used to be. Pinned to the right edge with the
     * 180px gutter the route labels need, a 288px card's left edge lands at
     * 901..980px's copy (which ends at 423..461) with 2–9px to spare — less
     * than the scrollbar itself. 240 buys 40–90px of air on the copy side
     * while leaving 166px+ on the label side, which is the side with the
     * smaller budget. */
    .dock-card { width: min(240px, 28vw); }
    .dock-tree__group-label,
    .dock-tree__row { font-size: 12px; }
    /* No room to the left of a 240px card on a 900px window, so the preview
     * opens over the card's own left half instead of beside it. It is still
     * pointer-transparent, so nothing is ever unreachable underneath it. */
    .dock-preview { margin-right: 10px; width: min(252px, calc(100vw - 40px)); }
  }

  /* Phone: the film degrades to stills, so the card becomes the page. The
   * rail stops travelling — an endless loop on a phone is noise, not news — and
   * the research sits under it exactly as on desktop. */
  @media (max-width: 760px) {
    .dock {
      --dock-news-h: auto;
      justify-items: center;
      min-height: 0;
      padding: 88px 0 56px;
    }
    .dock-card { margin-inline: 0; width: min(92%, 380px); }
    .dock-viewport {
      -webkit-mask-image: none;
      height: auto;
      mask-image: none;
      overflow: visible;
    }
    .dock-track { animation: none; }
    .dock-item__label { font-size: 15px; }
    /* A hover-only affordance is meaningless on touch, and the preview cannot
     * be reached, so the card simply does not exist at this width. */
    .dock-preview { display: none; }
  }

  /* Reduced motion: no clone, no travel, and the mask is dropped so the list
   * reads as an ordinary finite list instead of a column with its top hidden. */
  @media (prefers-reduced-motion: reduce) {
    .dock-viewport {
      -webkit-mask-image: none;
      height: auto;
      mask-image: none;
    }
    .dock-track { animation: none; }
  }
</style>

<script>
  // Two behaviours, both scoped to this section so a second copy on the page
  // can never observe the first copy's elements.
  document.querySelectorAll('[data-dock]').forEach((dock) => {
    // ── masthead height ─────────────────────────────────────────────
    // The dock is centred in the band of screen the masthead leaves free, so
    // that band has to be measured rather than assumed. The masthead is two
    // rows at some widths and one at others, and it is the LAYOUT that owns its
    // height -- duplicating the number here would silently drift the moment a
    // breakpoint, a font metric or a nav label changed. Measured, written back
    // as a custom property, and re-measured on resize, so the CSS above never
    // needs to know the number.
    const mast = document.querySelector('.masthead');
    const syncMast = () => {
      if (!mast) return;
      // offsetHeight rather than getBoundingClientRect: this wants the LAYOUT
      // height, and must not pick up a transform or a fractional device-pixel
      // value that would put the band a pixel out.
      const h = Math.round(mast.offsetHeight);
      if (h > 0) dock.style.setProperty('--dock-mast', h + 'px');
    };
    syncMast();
    if (typeof ResizeObserver === 'function' && mast) {
      // ResizeObserver rather than the window resize event alone: the masthead
      // also changes height when the nav wraps because of a font that loaded
      // late or a long label, neither of which fires a window resize.
      new ResizeObserver(syncMast).observe(mast);
    }

    // ── the loop ─────────────────────────────────────────────────────
    // The track holds the real list plus a clone; the CLONE is what the
    // animation travels into and the track is what animates, so there is one
    // clock and one seam instead of two half-length animations meeting
    // slightly out of step.
    //
    // The distance is the first list's MEASURED height rather than 50% of the
    // track, because the track is `2n` lists PLUS nothing, but a percentage is
    // only correct if the two halves are byte-identical — and a border or a
    // margin on the last row makes them 1px different, which is enough to show
    // the same entry twice at the wrap.
    //
    // Without JS nothing is duplicated and nothing moves: the entries are simply
    // there to be read.
    const track = dock.querySelector('[data-dock-track]');
    const list = track && track.querySelector('.dock-list');

    if (track && list) {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      let clone = null;

      const measure = () => {
        // EXACTLY this list's height, and nothing else.
        // getBoundingClientRect().height on a flex column already includes the
        // list's internal row-gaps, and the track is a plain block box, so the
        // clone's first row starts precisely one list-height below the first
        // row. An earlier build added the row-gap ON TOP of that height, so it
        // over-travelled by one gap: at the wrap the last row had already
        // scrolled past and the same entry appeared twice in a row.
        return list.getBoundingClientRect().height;
      };

      const build = () => {
        if (reduce.matches || clone) return;
        clone = list.cloneNode(true);
        clone.setAttribute('aria-hidden', 'true');
        // The clone is a second lap of the same entries, so it must be
        // unreachable by keyboard and by assistive tech — otherwise every row
        // is focusable twice and a screen reader reads the list ten times over.
        // `inert` does both in one attribute; the fallback for engines without
        // it is the tabindex sweep on the clone's own buttons.
        if ('inert' in HTMLElement.prototype) {
          clone.inert = true;
        }
        // The tabindex sweep runs UNCONDITIONALLY, not only as a fallback for
        // engines without `inert`. `inert` and `tabindex` are not the same
        // thing and do not always agree: with `inert` set, the clone's ten
        // buttons still each reported tabIndex 0, and in the engines where
        // that is true a keyboard user tabs straight through the invisible
        // second lap -- ten phantom stops that each open a preview for an entry
        // that is not the one on screen. Setting the attribute as well makes
        // the clone unreachable on every engine, and inert still supplies the
        // accessibility-tree half.
        clone.querySelectorAll('[data-dock-item]').forEach((b) => b.setAttribute('tabindex', '-1'));
        // The clone carries the same class, so it inherits the same row styling;
        // the track itself is a block box with no gap, which is what keeps the
        // two lists flush and the loop seamless.
        track.appendChild(clone);

        const distance = measure();
        track.style.setProperty('--dock-loop-px', `${distance}px`);
        // ~21px/s: a 56px row is ~2.7s, a ten-row list a ~27s turn. The distance
        // is derived, so the timing stays correct if the rail is resized to a
        // different pitch at one of the breakpoints.
        track.style.setProperty('--dock-loop', `${(distance / 21).toFixed(2)}s`);
        track.classList.add('dock-track--loop');
      };

      const teardown = () => {
        track.classList.remove('dock-track--loop');
        if (clone && clone.parentNode) clone.parentNode.removeChild(clone);
        clone = null;
      };

      const sync = () => (reduce.matches ? teardown() : build());
      sync();

      // Re-measure on resize: the row pitch changes at the breakpoints above, so
      // a distance captured once at load would drift out of phase with the new
      // geometry and the seam would reappear as a duplicated row.
      let w = window.innerWidth;
      window.addEventListener('resize', () => {
        if (window.innerWidth === w) return;
        w = window.innerWidth;
        if (clone) teardown();
        sync();
      });

      if (reduce.addEventListener) reduce.addEventListener('change', sync);
      else if (reduce.addListener) reduce.addListener(sync);
    }

    // ── hover / focus preview ────────────────────────────────────────
    // One card, filled from the JSON the component emitted, opened on pointer
    // enter and on focus, closed on leave, blur and Escape. The row is a real
    // <button>, so a keyboard user gets exactly what a mouse user gets.
    const preview = dock.querySelector('[data-dock-preview]');
    if (!preview) return;
    const pImg = preview.querySelector('[data-dock-preview-img]');
    const pKind = preview.querySelector('[data-dock-preview-kind]');
    const pDate = preview.querySelector('[data-dock-preview-date]');
    const pTitle = preview.querySelector('[data-dock-preview-title]');
    const pText = preview.querySelector('[data-dock-preview-text]');
    const pCta = preview.querySelector('[data-dock-preview-cta]');
    if (!pImg || !pKind || !pDate || !pTitle || !pText || !pCta) return;

    // Touch has no hover, and the preview is pointer-transparent by design, so
    // there is nothing to open it with at this width — the CSS hides the card
    // entirely. Building the handlers anyway would cost every entry a listener
    // and the map lookups for a preview that can never be seen.
    if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;

    let ART = {}, KIND = {}, TEXT = {}, SHORT = {}, DATE = {}, LINK = {};
    try {
      ART = JSON.parse(dock.dataset.dockArt || '{}');
      KIND = JSON.parse(dock.dataset.dockKinds || '{}');
      TEXT = JSON.parse(dock.dataset.dockText || '{}');
      SHORT = JSON.parse(dock.dataset.dockShort || '{}');
      DATE = JSON.parse(dock.dataset.dockDates || '{}');
      LINK = JSON.parse(dock.dataset.dockLinks || '{}');
    } catch (e) {
      // A malformed map must not take the whole page's script down with it: the
      // rail still loops and the entries still read. Only the preview is lost.
      return;
    }

    const newsEl = dock.querySelector('[data-dock-news]');
    let current = null;
    let hideTimer = null;

    const fill = (id) => {
      if (current === id) return true;
      if (!DATE[id]) return false;
      current = id;
      const art = ART[id];
      // Reassigning `src` to the same value is a no-op in every current engine,
      // but the explicit guard also covers the case where the image failed and
      // a later hover should be allowed to retry it.
      if (art && pImg.getAttribute('src') !== art) pImg.src = art;
      pImg.alt = '';
      pKind.textContent = KIND[id] || '';
      pDate.textContent = DATE[id] || '';
      pTitle.textContent = SHORT[id] || '';
      pText.textContent = TEXT[id] || '';
      const href = LINK[id];
      pCta.hidden = !href;
      if (href) pCta.href = href;
      return true;
    };

    const open = (id, row) => {
      if (hideTimer) { clearTimeout(hideTimer); hideTimer = null; }
      if (!fill(id)) return;
      // Follow the pointer down the rail: the preview is pinned to the card's top
      // edge, so opening it once at a fixed spot would leave it hanging over
      // unrelated entries as soon as the reader moved on.
      //
      // The row that was hovered is used directly rather than re-queried by id,
      // for two reasons. The loop clones the list, so a query by id matches the
      // ORIGINAL row while the pointer may be over its clone in the second lap
      // — the preview would then sit at the first lap's position. And the track
      // carries a CSS transform, which offsetTop does not see: measuring the
      // rect instead is what makes the preview line up with the row the reader
      // is actually pointing at. This runs once per hover, not per pointermove,
      // so the read is not a cost.
      if (row) {
        const cardTop = preview.offsetParent ? preview.offsetParent.getBoundingClientRect().top : 0;
        const y = row.getBoundingClientRect().top - cardTop - 20;
        // Keep the card inside the viewport: past the last row, an unbounded top
        // would push the preview's bottom off the bottom of a short window.
        const room = dock.clientHeight - preview.offsetHeight - 24;
        preview.style.top = Math.max(0, Math.min(y, Math.max(0, room))) + 'px';
      }
      if (preview.hidden) {
        preview.hidden = false;
        // One frame with the class applied is what lets the transition run: a
        // class added in the same frame as the un-hide is applied in the same
        // style recalculation and the browser has no "from" state to animate
        // from, so the card would appear instantly.
        requestAnimationFrame(() => preview.classList.add('is-open'));
      } else {
        preview.classList.add('is-open');
      }
      if (newsEl) newsEl.classList.add('is-paused');
      dock.querySelectorAll('.dock-row.is-hot').forEach((r) => r.classList.remove('is-hot'));
      if (row) row.classList.add('is-hot');
    };

    // `pointer-events: none` on the preview means the pointer never actually
    // enters it, so a plain leave handler would dismiss the card the moment
    // the reader crossed the 14px gap between the rail and the preview — the
    // one move the preview exists to survive. The gap sits INSIDE this
    // section, so a leave whose relatedTarget is still within the section is
    // the reader crossing the gap, not leaving: hold the card and let the next
    // row's enter (or the section's own leave) decide.
    const close = (e) => {
      if (e && e.relatedTarget && dock.contains(e.relatedTarget)) return;
      if (hideTimer) return;
      preview.classList.remove('is-open');
      if (newsEl) newsEl.classList.remove('is-paused');
      dock.querySelectorAll('.dock-row.is-hot').forEach((r) => r.classList.remove('is-hot'));
      // A short delay on top of the gap check, so a fast diagonal that leaves
      // and re-enters within a frame or two does not make the card flash.
      hideTimer = setTimeout(() => {
        preview.hidden = true;
        current = null;
        hideTimer = null;
      }, 220);
    };

    dock.querySelectorAll('[data-dock-item]').forEach((btn) => {
      const id = btn.dataset.id;
      if (!id) return;
      const row = btn.closest('.dock-row');
      btn.addEventListener('pointerenter', () => open(id, row));
      btn.addEventListener('focus', () => open(id, row));
      btn.addEventListener('pointerleave', close);
      btn.addEventListener('blur', close);
      btn.addEventListener('click', () => open(id, row));
    });

    // Close when the pointer leaves the card entirely, and on Escape — the two
    // ways a preview can otherwise be stranded on screen with nothing hovered.
    dock.addEventListener('pointerleave', close);
    dock.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
  });
</script>
