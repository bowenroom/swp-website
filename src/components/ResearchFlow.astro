---
// 研究方向 / Research directions — the right-hand panel of the homepage.
//
// Design: OpenViking-style minimal wireframe flow diagram, fused with Kami warm
// parchment tones. Three numbered steps connected by arrows, sitting on top of
// a shared "method foundation" layer. The structure mirrors the user's actual
// research causal chain:
//
//   Application (road safety emergency)
//     → Objects (UAV + autonomous driving)
//       → Method (multimodal VLM + multi-agent collaboration)
//
// Interactions:
//   - Hover: step highlights, arrow animates
//   - Click: step expands to show detailed description
//   - The foundation layer is always visible, supporting all steps
//
// Style: thin borders, light background, no shadows, numbered titles.
// Colors: Kami parchment (#f5f4ed) + ink blue (#1B365D) + muted accents.
import { researchFor } from '../content/research.js';

const { lang } = Astro.props;
const research = researchFor(lang);
const isZh = lang === 'zh';

// The three steps of the research causal chain.
// These are the actual research directions, not generic placeholders.
const STEPS = [
  {
    id: 'emergency',
    number: '01',
    title: isZh ? '道路安全应急' : 'Road Safety Emergency',
    description: isZh
      ? '应用层：研究要解决的实际问题。交通事故、道路拥堵、应急响应——这些是研究的出发点。'
      : 'Application layer: the real problems to solve. Traffic accidents, road congestion, emergency response — these are where the research starts.',
    accent: '#5b7fa6',
  },
  {
    id: 'vehicles',
    number: '02',
    title: isZh ? '无人机 + 无人驾驶' : 'UAV + Autonomous Driving',
    description: isZh
      ? '载体层：感知与执行的物理平台。无人机巡检、无人车配送、辅助驾驶——这些是研究的物理载体。'
      : 'Carrier layer: the physical platforms for perception and execution. UAV inspection, unmanned delivery, assisted driving — these are the physical carriers.',
    accent: '#8a6f4e',
  },
  {
    id: 'method',
    number: '03',
    title: isZh ? '多模态VLM + 多智能体' : 'Multimodal VLM + Multi-Agent',
    description: isZh
      ? '方法层：支撑应用与载体的技术底座。视觉语言模型做多模态理解，多智能体做协同决策。'
      : 'Method layer: the technical foundation supporting applications and carriers. Vision-language models for multimodal understanding, multi-agent systems for collaborative decision-making.',
    accent: '#4f7d6a',
  },
];

// The foundation layer — the shared method that supports all steps.
const FOUNDATION = {
  title: isZh ? '方法底座' : 'Method Foundation',
  description: isZh
    ? '多模态视觉语言大模型 + 多智能体协同决策'
    : 'Multimodal Vision-Language Models + Multi-Agent Collaborative Decision',
  tags: isZh
    ? ['视觉语言模型', '多智能体', '协同决策']
    : ['Vision-Language Model', 'Multi-Agent', 'Collaborative Decision'],
};
---

<section class="research-flow" data-research-flow aria-labelledby="research-flow-title">
  <div class="research-flow__panel">
    <h2 id="research-flow-title" class="research-flow__kicker">
      {isZh ? '研究方向' : 'Research'}
    </h2>
    <!-- ── Steps row ───────────────────────────────────────────── -->
    <div class="research-flow__steps">
      {STEPS.map((step, i) => (
        <div class="research-flow__step-wrapper">
          <button
            class="research-flow__step"
            data-step={step.id}
            type="button"
            aria-expanded="false"
            style={`--step-accent: ${step.accent}`}
          >
            <span class="research-flow__step-number">{step.number}</span>
            <span class="research-flow__step-title">{step.title}</span>
            <span class="research-flow__step-toggle" aria-hidden="true">
              {/* Two paths, not one: the horizontal one stays and the vertical
                  one fades as the step opens, so + becomes − instead of the
                  icon having to be swapped on every click. */}
              <svg viewBox="0 0 16 16">
                <path class="research-flow__toggle-h" d="M3 8h10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                <path class="research-flow__toggle-v" d="M8 3v10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              </svg>
            </span>
            <span class="research-flow__step-description" data-step-description>
              {step.description}
            </span>
          </button>
          {i < STEPS.length - 1 && (
            <div class="research-flow__arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M4 12h14M14 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
          )}
        </div>
      ))}
    </div>

    <!-- ── Foundation layer ─────────────────────────────────────── -->
    <div class="research-flow__foundation">
      <div class="research-flow__foundation-header">
        <span class="research-flow__foundation-title">{FOUNDATION.title}</span>
      </div>
      <div class="research-flow__foundation-body">
        <p class="research-flow__foundation-desc">{FOUNDATION.description}</p>
        <div class="research-flow__foundation-tags">
          {FOUNDATION.tags.map((tag) => (
            <span class="research-flow__foundation-tag">{tag}</span>
          ))}
        </div>
      </div>
    </div>

    <!-- ── Connecting arrows (steps → foundation) ───────────────── -->
    <div class="research-flow__connectors" aria-hidden="true">
      {STEPS.map((step) => (
        <div class="research-flow__connector" data-connector={step.id}>
          <svg viewBox="0 0 24 48">
            <path d="M12 0v36M6 30l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .research-flow {
    --rf-bg: #fbf5eb;
    --rf-border: #d3cfc4;
    --rf-panel: #fff9ef;
    --rf-ink: #1d1a15;
    --rf-ink-soft: #2e281e;
    --rf-accent: #1B365D;
    --rf-teal: #39715f;
    --rf-guide: #dbd5cb;
    --rf-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
      'Hiragino Sans GB', 'Microsoft YaHei', system-ui, sans-serif;
    --rf-mono: ui-monospace, 'SF Mono', SFMono-Regular, 'JetBrains Mono',
      'Roboto Mono', Menlo, Consolas, 'Liberation Mono', monospace;

    /* Layout is owned by the parent .homepage-panels flex container in
     * index.astro — this component only provides the panel itself. */
    position: relative;
    z-index: 130;
    /* See the note in index.astro: the wrapper's `> *` re-enable is scoped to
     * that file's cid and never reaches this child component's root. */
    pointer-events: auto;
  }

    /* Same micro-label the news card carries, so the two panels read as a pair:
     12px, 600, wide tracking, uppercase — the one place tracking is sanctioned. */
  .research-flow__kicker {
    color: var(--rf-teal);
    font-family: var(--rf-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    line-height: 1.5;
    margin: 0 0 8px;
    text-transform: uppercase;
  }


  .research-flow__panel {
    backdrop-filter: blur(12px) saturate(118%);
    -webkit-backdrop-filter: blur(12px) saturate(118%);
    background: color-mix(in srgb, var(--rf-bg) 90%, transparent);
    border: 1px solid var(--rf-border);
    /* Elevation to match the news card on the other side — two panels floating
     * over the film should read as the same kind of object. */
    box-shadow: var(--shadow-soft);
    /* The gutter is the film's route furniture, not an aesthetic choice: that
     * rail hangs a label pill ~49px off its left side, and the widest pill's
     * left edge sits a constant ~160px in from the viewport — EN's
     * "Coordination" is wider than any Chinese label, so EN sets the budget.
     *
     * 180 -> 156 moves this panel 24px further right, which is as far as it
     * can go: the full 10% (36px) would leave EN 4px of air. At 156 the panel
     * edge and the pill edge are both measured from the same right-hand side,
     * so the clearance holds at 16px at every viewport width. */
    margin-right: 156px;
    max-width: calc(100vw - 40px);
    /* 14px, not 20: at 180px the old padding left 138px of content while the news card opposite gave its rows 148px. */
    padding: 16px 14px 14px;
    position: relative;
    /* Half the old 360px — three numbered steps and a tag row were claiming a
     * quarter of the screen. */
    width: clamp(148px, 12.5vw, 186px);
  }

  

  /* ── Steps ─────────────────────────────────────────────────── */
    .research-flow__steps {
    border-top: 1px solid color-mix(in srgb, var(--rf-guide) 85%, transparent);
    display: flex;
    flex-direction: column;
    margin-bottom: 14px;
  }


    /* Step, then the chain arrow UNDER it: side by side at 180px cost the step
     28px of a column that only has 150px to give. */
  .research-flow__step-wrapper {
    align-items: center;
    display: flex;
    flex-direction: column;
  }


    .research-flow__step {
    align-items: flex-start;
    background: none;
    border: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--rf-guide) 85%, transparent);
    color: inherit;
    cursor: pointer;
    display: flex;
    flex: 1;
    flex-direction: column;
    font: inherit;
    gap: 2px;
    padding: 9px 26px 10px 12px;
    position: relative;
    text-align: left;
    transition: background 0.2s ease;
    width: 100%;
  }

  /* The accent rail from the news card, so both panels light up the same way:
     a bar scaled on the GPU rather than layout animated on a row the marquee
     is already transforming. */
  .research-flow__step::before {
    background: var(--step-accent, var(--rf-accent));
    content: '';
    height: 100%;
    left: 0;
    position: absolute;
    top: 0;
    transform: scaleY(0);
    transform-origin: center;
    transition: transform 0.2s ease;
    width: 2px;
  }

  .research-flow__step:hover::before,
  .research-flow__step:focus-visible::before,
  .research-flow__step[aria-expanded='true']::before {
    transform: scaleY(1);
  }


    .research-flow__step:hover,
  .research-flow__step:focus-visible {
    background: color-mix(in srgb, var(--rf-panel) 70%, transparent);
  }


  .research-flow__step:focus-visible {
    outline: 2px solid var(--step-accent, var(--rf-accent));
    outline-offset: 2px;
  }

  .research-flow__step-number {
    color: var(--step-accent, var(--rf-accent));
    font-family: var(--rf-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.4;
  }

    .research-flow__step-title {
    color: var(--rf-ink);
    font-family: var(--rf-sans);
    font-size: 13.5px;
    font-weight: 600;
    line-height: 1.45;
    transition: color 0.18s ease;
  }

  .research-flow__step:hover .research-flow__step-title,
  .research-flow__step:focus-visible .research-flow__step-title,
  .research-flow__step[aria-expanded='true'] .research-flow__step-title {
    color: var(--rf-accent);
  }


    .research-flow__step-toggle {
    color: var(--rf-ink-soft);
    height: 14px;
    opacity: 0.45;
    position: absolute;
    right: 10px;
    top: 11px;
    transition: opacity 0.2s ease;
    width: 14px;
  }


  .research-flow__step:hover .research-flow__step-toggle,
  .research-flow__step:focus-visible .research-flow__step-toggle {
    opacity: 1;
  }

  .research-flow__step-toggle svg {
    display: block;
    height: 100%;
    width: 100%;
  }

    /* The height is written inline by the script, which asks Pretext what this
     text measures at this exact width BEFORE the animation starts. The old
     `max-height: 200px` guessed in both directions: short descriptions slid
     into place over distance that never existed, and anything past 200px was
     cut off. */
  /* :global — these line spans are written at runtime by the typesetter, so
     they never carry this component's data-astro-cid and a scoped selector
     would silently miss them. */
  :global(.pt-line) {
    display: block;
  }

  .research-flow__step-description {
    color: var(--rf-ink-soft);
    display: block;
    font-family: var(--rf-sans);
    font-size: 12px;
    height: 0;
    line-height: 1.6;
    overflow: hidden;
    transition: height 0.3s ease;
  }

  .research-flow__step-toggle-v {
    transition: opacity 0.2s ease;
  }

  .research-flow__step[aria-expanded='true'] .research-flow__toggle-v {
    opacity: 0;
  }

  /* The chain arrows carry the argument of this panel (application -> carrier
     -> method), so at this size they are tinted toward the accent rather than
     the hairline colour: in the guide colour they read as stray marks. */
  .research-flow__arrow {
    color: color-mix(in srgb, var(--rf-accent) 55%, var(--rf-guide));
    height: 14px;
    margin: 4px 0;
    width: 14px;
  }


  .research-flow__arrow svg {
    display: block;
    height: 100%;
    width: 100%;
  }

  /* ── Foundation ────────────────────────────────────────────── */
    /* No second box: a bordered block inside a bordered panel was the boxiest
     thing on the page. A rule across the top separates it for 1px instead of
     four borders. */
  .research-flow__foundation {
    background: none;
    border-top: 1px solid color-mix(in srgb, var(--rf-guide) 85%, transparent);
    padding-top: 12px;
  }

  .research-flow__foundation-header {
    margin-bottom: 8px;
  }

  .research-flow__foundation-title {
    color: var(--rf-accent);
    font-family: var(--rf-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

.research-flow__foundation-desc {
    color: var(--rf-ink-soft);
    font-family: var(--rf-sans);
    font-size: 12px;
    line-height: 1.6;
    margin: 0 0 10px;
  }

  .research-flow__foundation-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

    .research-flow__foundation-tag {
    background: color-mix(in srgb, var(--rf-panel) 86%, transparent);
    border: 1px solid var(--rf-guide);
    border-radius: 999px;
    color: var(--rf-ink-soft);
    font-family: var(--rf-sans);
    font-size: 10.5px;
    line-height: 1.5;
    padding: 2px 8px;
  }


  /* ── Connectors (visual only) ──────────────────────────────── */
  .research-flow__connectors {
    display: flex;
    justify-content: space-around;
    margin-top: 8px;
    pointer-events: none;
  }

  .research-flow__connector {
    color: var(--rf-guide);
    height: 24px;
    width: 24px;
  }

  .research-flow__connector svg {
    display: block;
    height: 100%;
    width: 100%;
  }

  /* ── Responsive ────────────────────────────────────────────── */
  @media (max-width: 1180px) {
    .research-flow__panel {
      width: clamp(140px, 14vw, 165px);
    }
    .research-flow__step-title {
      font-size: 13px;
    }
  }

  @media (max-width: 980px) {
    .research-flow {
      padding: 18px 0 22px;
    }
    .research-flow__panel {
      width: min(170px, 26vw);
    }
  }

  @media (max-width: 760px) {
    .research-flow {
      justify-items: center;
      min-height: 0;
      padding: 88px 0 56px;
    }
    .research-flow__panel {
      margin-right: 0;
      width: min(92%, 380px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .research-flow__step,
    .research-flow__step-description,
    .research-flow__step-toggle {
      transition: none;
    }
  }
</style>

<script>
  import { typesetAll, measureTextHeight } from '../scripts/pretext-typeset';

  // Two jobs: break this panel's copy the same way the news card does, and
  // open each step at EXACTLY the height its text needs.
  //
  // The height is the part CSS could not do. The description animates from
  // height 0, and at height 0 the element has no laid-out text for
  // getBoundingClientRect to read — which is why this used to be
  // `max-height: 200px`, a guess that played short descriptions out slowly
  // and cut long ones off. Pretext lays the paragraph out arithmetically at
  // the panel's real width first, so the animation is told its destination
  // before it starts and nothing shifts while it runs.
  document.querySelectorAll('[data-research-flow]').forEach((panel) => {
    const typeset = () => {
      typesetAll(panel, '.research-flow__step-title');
      typesetAll(panel, '[data-step-description]');
      typesetAll(panel, '.research-flow__foundation-desc');
    };
    typeset();

    panel.querySelectorAll('[data-step]').forEach((step) => {
      const desc = step.querySelector('[data-step-description]');
      if (!desc) return;

      step.addEventListener('click', () => {
        const expanded = step.getAttribute('aria-expanded') === 'true';
        if (expanded) {
          // From wherever it is now: 'auto' after a finished animation, or a
          // pixel value mid-flight. Measuring first means the collapse covers
          // the same distance the expansion did.
          desc.style.height = desc.getBoundingClientRect().height + 'px';
          void desc.offsetHeight;
          desc.style.height = '0px';
          step.setAttribute('aria-expanded', 'false');
          return;
        }
        const height = measureTextHeight(desc);
        // 0 means the measurement failed (no width, or a font that would not
        // parse). Refusing to open is correct: an open step with no height
        // would clip its own text, which is the bug this replaced.
        if (!height) return;
        desc.style.height = '0px';
        void desc.offsetHeight;
        desc.style.height = height + 'px';
        step.setAttribute('aria-expanded', 'true');
      });

      desc.addEventListener('transitionend', (event) => {
        if (event.propertyName !== 'height') return;
        // Hand the height back to layout once the move is done: a resize or a
        // late font has to be able to reflow an open step.
        if (step.getAttribute('aria-expanded') === 'true') desc.style.height = 'auto';
      });
    });

    // A web font landing re-breaks every paragraph here, so the copy is
    // re-typeset and any step left open is given its height back.
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready
        .then(() => {
          typeset();
          panel
            .querySelectorAll('[data-step][aria-expanded="true"] [data-step-description]')
            .forEach((d) => { d.style.height = 'auto'; });
        })
        .catch(() => {});
    }
  });
</script>
