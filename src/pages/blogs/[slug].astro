---
// Chinese half of the post route. The English half lives at
// src/pages/en/blogs/[slug].astro and is a separate file on purpose: one
// dynamic route cannot emit two different URLs for the same slug, so a single
// [slug].astro returning both languages renders /blogs/<slug> twice and the
// second write is silently dropped as a route conflict.
//
// The glob is eager so a missing body fails HERE, at build time, rather than
// shipping a post page with a title and no body.
import Post from '../../layouts/Post.astro';
import { posts } from '../../content/posts.js';

export function getStaticPaths() {
  return posts.map((p) => ({ params: { slug: p.slug }, props: { slug: p.slug } }));
}

const bodies = import.meta.glob('../../content/posts/*.zh.md', { eager: true });

const { slug } = Astro.props;
const key = '../../content/posts/' + slug + '.zh.md';
const body = bodies[key];
if (!body) throw new Error('missing zh body for post "' + slug + '" (expected ' + key + ')');
const Content = body.default;
---

<Post slug={slug} lang="zh">
  <Content />
</Post>
